	cd /home/schundu3/projects/ornl_tools/ORNL_QIS_Stack/exatn/build && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
